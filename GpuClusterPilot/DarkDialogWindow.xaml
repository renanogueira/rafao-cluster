<Window x:Class="RafaoCluster.DarkDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rafão Cluster" Width="520" SizeToContent="Height" MinHeight="220"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" Background="#0B1020" Foreground="White">
  <Border Background="{StaticResource Bg}" Padding="26">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="DialogTitle" FontSize="22" FontWeight="Bold" Foreground="White" />
      <TextBlock x:Name="DialogMessage" Grid.Row="1" Margin="0,16,0,24" FontSize="14" Foreground="White" TextWrapping="Wrap" LineHeight="21" />
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="NoButton" Content="Cancelar" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="No_Click" />
        <Button x:Name="YesButton" Content="OK" Click="Yes_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
