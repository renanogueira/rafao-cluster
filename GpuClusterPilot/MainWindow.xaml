<Window x:Class="RafaoCluster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rafão Cluster" Width="1120" Height="760" MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#0B1020" Foreground="White">
  <Grid Margin="26" Background="#0B1020">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" />
      <ColumnDefinition Width="22" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#10172A" CornerRadius="18" Padding="22">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <Border Width="48" Height="48" Background="{StaticResource Accent}" CornerRadius="14" HorizontalAlignment="Left">
            <TextBlock Text="R" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Rafão Cluster" FontSize="23" FontWeight="Bold" Margin="0,14,0,4" />
          <TextBlock Text="LLMs grandes, vários PCs." Foreground="{StaticResource Muted}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,34,0,0">
          <TextBlock Text="PAPEL DESTE PC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" />
          <Button x:Name="CoordinatorRole" Content="◆  Coordenador" Margin="0,10,0,8" Click="CoordinatorRole_Click" />
          <Button x:Name="WorkerRole" Content="◇  Worker" Style="{StaticResource SecondaryButton}" Click="WorkerRole_Click" />
        </StackPanel>

        <StackPanel Grid.Row="3">
          <TextBlock x:Name="InstallStatus" Text="llama.cpp: verificando..." Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
          <Button Content="Instalar / atualizar" Click="Install_Click" />
          <TextBlock Text="Ações administrativas sempre pedem confirmação." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Configurar coordenador" FontSize="30" FontWeight="Bold" Foreground="White" />
          <TextBlock x:Name="PageSubtitle" Text="Este PC organiza as GPUs e expõe a API local." Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="↻  Diagnosticar" Style="{StaticResource SecondaryButton}" Click="Scan_Click" />
      </Grid>

      <ScrollViewer Grid.Row="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Diagnóstico" FontSize="17" FontWeight="SemiBold" />
              <TextBlock x:Name="HardwareSummary" Text="Clique em Diagnosticar para detectar GPU, VRAM e rede." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="PrimaryLabel" Text="Workers (IP:porta, separados por vírgula)" Foreground="{StaticResource Muted}" Margin="0,0,0,7" />
                <TextBox x:Name="PrimaryInput" Text="" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock x:Name="SecondaryLabel" Text="Modelo GGUF" Foreground="{StaticResource Muted}" Margin="0,0,0,7" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="SecondaryInput" />
                  <Button x:Name="BrowseButton" Grid.Column="1" Content="…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Browse_Click" />
                  <Button x:Name="DownloadModelButton" Grid.Column="2" Content="↓ Baixar GGUF" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="DownloadModel_Click" />
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Porta RPC" Foreground="{StaticResource Muted}" Margin="0,0,0,7" />
                <TextBox x:Name="RpcPortInput" Text="50052" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock x:Name="ThirdLabel" Text="Porta da API" Foreground="{StaticResource Muted}" Margin="0,0,0,7" />
                <TextBox x:Name="ThirdInput" Text="8080" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock x:Name="FourthLabel" Text="Contexto" Foreground="{StaticResource Muted}" Margin="0,0,0,7" />
                <TextBox x:Name="FourthInput" Text="4096" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="Execução" FontSize="17" FontWeight="SemiBold" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="FirewallButton" Content="Configurar firewall" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="Firewall_Click" />
                  <Button x:Name="StartButton" Content="Iniciar coordenador" Click="Start_Click" />
                  <Button x:Name="StopButton" Content="Parar" Background="{StaticResource Danger}" Margin="8,0,0,0" IsEnabled="False" Click="Stop_Click" />
                </StackPanel>
              </DockPanel>
              <Border Background="#0B1020" BorderBrush="#283654" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.8*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1.6*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="RPC" Foreground="{StaticResource Muted}" FontSize="11" />
                    <TextBlock x:Name="RpcTelemetry" Text="○ Parado" FontWeight="SemiBold" Margin="0,3,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="GPU" Foreground="{StaticResource Muted}" FontSize="11" />
                    <TextBlock x:Name="GpuTelemetry" Text="Aguardando diagnóstico" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="GPU usada pelo worker" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="14,0,0,0">
                    <TextBlock Text="VRAM / USO" Foreground="{StaticResource Muted}" FontSize="11" />
                    <TextBlock x:Name="VramTelemetry" Text="—" FontWeight="SemiBold" Margin="0,3,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Margin="14,0,0,0">
                    <TextBlock Text="INFERÊNCIA REMOTA" Foreground="{StaticResource Muted}" FontSize="11" />
                    <TextBlock x:Name="WorkTelemetry" Text="Aguardando" FontWeight="SemiBold" Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
              </Border>
              <TextBox x:Name="LogBox" Height="165" Margin="0,14,0,0" IsReadOnly="True"
                       FontFamily="Cascadia Mono,Consolas" FontSize="12" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
