<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RafaoCluster.CrossPlatform.MainWindow"
 Title="Rafão Cluster" Width="1100" Height="780" MinWidth="940" MinHeight="680" Background="#0B1020">
 <Grid Margin="24" ColumnDefinitions="245,22,*" Background="#0B1020">
  <Border Grid.Column="0" Background="#10172A" CornerRadius="18" Padding="20">
   <Grid RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel><Border Width="48" Height="48" Background="#735DF5" CornerRadius="14" HorizontalAlignment="Left"><TextBlock Text="R" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Rafão Cluster" FontSize="23" FontWeight="Bold" Margin="0,14,0,3"/><TextBlock x:Name="PlatformText" Text="macOS / Linux"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,30,0,0"><TextBlock Text="PAPEL DESTE PC" FontSize="11" FontWeight="Bold"/><Button x:Name="CoordinatorRole" Content="◆  Coordenador" Margin="0,10,0,8" Click="CoordinatorRole_Click"/><Button x:Name="WorkerRole" Content="◇  Worker" Classes="secondary" Click="WorkerRole_Click"/></StackPanel>
    <StackPanel Grid.Row="3"><TextBlock x:Name="InstallStatus" Text="○ llama.cpp: verificando" Margin="0,0,0,10"/><Button Content="Instalar / atualizar" Click="Install_Click"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="2" RowDefinitions="Auto,*">
   <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock x:Name="PageTitle" Text="Configurar coordenador" FontSize="29" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="Este computador organiza as GPUs e expõe a API local." Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="↻  Diagnosticar" Classes="secondary" Click="Scan_Click"/></Grid>
   <ScrollViewer Grid.Row="1" Margin="0,22,0,0"><StackPanel>
    <Border Classes="card"><StackPanel><TextBlock Text="Diagnóstico" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="HardwareSummary" Text="Detectando hardware..." TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Classes="card"><Grid ColumnDefinitions="*,18,*"><StackPanel><TextBlock x:Name="PrimaryLabel" Text="Workers (IP:porta, separados por vírgula)" Margin="0,0,0,7"/><TextBox x:Name="PrimaryInput"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="SecondaryLabel" Text="Modelo GGUF" Margin="0,0,0,7"/><Grid ColumnDefinitions="*,Auto"><TextBox x:Name="SecondaryInput"/><Button x:Name="DownloadButton" Grid.Column="1" Content="↓ Baixar GGUF" Classes="secondary" Margin="8,0,0,0" Click="DownloadModel_Click"/></Grid></StackPanel></Grid></Border>
    <Border Classes="card"><Grid ColumnDefinitions="*,18,*,18,*"><StackPanel><TextBlock Text="Porta RPC" Margin="0,0,0,7"/><TextBox x:Name="RpcPortInput" Text="50052"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="ThirdLabel" Text="Porta da API" Margin="0,0,0,7"/><TextBox x:Name="ThirdInput" Text="8080"/></StackPanel><StackPanel Grid.Column="4"><TextBlock x:Name="FourthLabel" Text="Contexto" Margin="0,0,0,7"/><TextBox x:Name="FourthInput" Text="4096"/></StackPanel></Grid></Border>
    <Border Classes="card"><StackPanel><Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="Execução" FontSize="17" FontWeight="SemiBold"/><Button x:Name="StartButton" Grid.Column="1" Content="Iniciar coordenador" Click="Start_Click"/><Button x:Name="StopButton" Grid.Column="2" Content="Parar" Background="#B93E55" Margin="8,0,0,0" IsEnabled="False" Click="Stop_Click"/></Grid><TextBox x:Name="LogBox" Height="190" Margin="0,14,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="monospace"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
  </Grid>
 </Grid>
</Window>
